/*
 * Catppuccin Mocha
 * Transparent Rofi theme
 */

* {
    /* Catppuccin Mocha palette */
    rosewater: #f5e0dc;
    flamingo:  #f2cdcd;
    pink:      #f5c2e7;
    mauve:     #cba6f7;
    red:       #f38ba8;
    maroon:    #eba0ac;
    peach:     #fab387;
    yellow:    #f9e2af;
    green:     #a6e3a1;
    teal:      #94e2d5;
    sky:       #89dceb;
    sapphire:  #74c7ec;
    blue:      #89b4fa;
    lavender:  #b4befe;

    text:      #cdd6f4;
    subtext1:  #bac2de;
    subtext0:  #a6adc8;

    overlay2:  #9399b2;
    overlay1:  #7f849c;
    overlay0:  #6c7086;

    surface2:  #585b70;
    surface1:  #45475a;
    surface0:  #313244;

    base:      #1e1e2e;
    mantle:    #181825;
    crust:     #11111b;

    font: "CaskaydiaCove Nerd Font 12";

    text-color: @text;
    background-color: transparent;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 650px;

    border: 2px;
    border-color: @mauve;
    border-radius: 15px;

    background-color: #1e1e2ed9;
}

inputbar {
    padding: 20px;
    spacing: 8px;

    border-radius: 15px;

    children: [ entry ];
}

entry {
    text-color: @text;
    placeholder: "Search...";
    placeholder-color: @overlay0;
}

message {
    border-radius: 15px;
    border-color: @surface0;
}

textbox {
    padding: 8px 24px;
    text-color: @text;
}

listview {
    lines: 6;
    columns: 2;

    cycle: false;
    scrollbar: true;
    fixed-height: true;
}

scrollbar {
    cursor: pointer;

    handle-width: 5px;
    handle-color: @surface2;
}

element {
    padding: 12px 16px;
    spacing: 8px;

    border-radius: 12px;
}

element normal normal {
    text-color: @text;
}

element selected normal,
element selected active {
    background-color: @surface1;
    text-color: @mauve;
}

element-text {
    text-color: inherit;
    highlight: bold;
}

element-icon {
    size: 1.2em;
    vertical-align: 0.5;
}
